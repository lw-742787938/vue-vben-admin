VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL="http://test.gohnstudio.top:8888"
# VITE_GLOB_API_URL="http://127.0.0.1:8888"

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=false

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
